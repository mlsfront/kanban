# 1. Desabilitar listagem de diretórios por segurança
Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# 2. Bloquear acesso direto a arquivos de configuração sensíveis (.env, .json, .log)
<FilesMatch "^\.|\.(env|json|log|ini|md|sql|bak|old)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Impedir a execução direta de scripts PHP dentro de pastas estruturais (opcional, mas recomendado)
# Se alguém tentar acessar kanban.mlsfront.com/core/config.php diretamente, receberá erro 403
RewriteEngine On
RewriteCond %{REQUEST_URI} ^/(core|config|helpers|logs|logs_archive)/ [NC]
RewriteCond %{REQUEST_URI} !/(save_board|get_board_db)\.php$ [NC]
RewriteRule \.php$ - [F,L]