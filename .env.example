# Desenvolvimento local / produção — nunca versionar valores reais
APP_URL=http://localhost/kanban/
DB_SERVER=127.0.0.1
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=kanban

# log registra apenas metadados; off desativa; smtp envia de verdade
MAIL_ENABLED=1
MAIL_DRIVER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=<seu_username>
MAIL_PASSWORD=<seu_password>
MAIL_ENCRYPTION=tls
# Use um endereço com domínio válido; não use noreply@localhost
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=KanbanApp
MAIL_DEBUG=0

# Caminhos opcionais; o padrão é a pasta logs/ do projeto
APP_LOG_PATH=/opt/lampp/htdocs/kanban/logs
MAIL_LOG_PATH=/opt/lampp/htdocs/kanban/logs/mail.log
